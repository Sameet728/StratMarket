# StratMarket by Elvaris Capital — Environment Configuration Template

# Database Configuration (MongoDB)
MONGODB_URI="mongodb://localhost:27017/stratmarket"
# Alternatively for MongoDB Atlas Cloud:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/stratmarket?retryWrites=true&w=majority"
MONGODB_DB_NAME="stratmarket"

# Authentication & Session Security (32+ character HMAC key)
JWT_SECRET="stratmarket-dev-jwt-super-secret-key-2026-secure"

# Elvaris Python VPS Gateway (HMAC SHA-256 Shared Secret)
VPS_SHARED_SECRET="stratmarket-dev-vps-hmac-shared-secret-key-2026"
VPS_API_ENDPOINT="http://localhost:3000/api/internal/signals"

# Transactional Email Provider ("console" for dev, "resend" for prod)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_..."
EMAIL_FROM="StratMarket Alerts <alerts@elvariscapital.in>"
SIGNAL_ALERT_RECIPIENT="alerts@elvariscapital.in"

# Payment Gateway ("stripe" or "razorpay")
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""

# Broker Security Vault (AES-256-GCM 32-byte secret)
CREDENTIAL_VAULT_KEY="stratmarket-dev-broker-vault-key-32b"
